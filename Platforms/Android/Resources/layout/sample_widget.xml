<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E2E"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=".NET MAUI Widget"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Kliknij poniższy przycisk, aby zaktualizować status"
        android:textColor="#A6ADC8"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_updated_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Ostatnia akt.: Brak"
        android:textColor="#89B4FA"
        android:textSize="11sp" />

    <Button
        android:id="@+id/widget_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="🔄 Odśwież Dane"
        android:backgroundColor="#89B4FA"
        android:textColor="#11111B"
        android:textSize="12sp" />

</LinearLayout>
